# Copie ce fichier en `secrets.properties` (non versionné) et renseigne la valeur.
# Alternative : définir la même clé comme variable d'environnement.
#
# Les accès du fournisseur IPTV ne se mettent PAS ici : ils sont saisis dans
# l'application au premier lancement (appairage par QR code sur la TV, ou
# formulaire sur téléphone), et ne sont jamais compilés dans l'APK.

# Clé API TMDB (v3), pour les affiches — https://www.themoviedb.org/settings/api
TMDB_KEY=
